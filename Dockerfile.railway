FROM node:20-alpine AS web-build

WORKDIR /build
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci --workspace=@clip-farm/web
COPY apps/web ./apps/web
RUN npm run build --workspace=@clip-farm/web


FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        libgl1 \
        libglib2.0-0 \
        supervisor \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY apps/api /app/apps/api
RUN pip install --no-cache-dir /app/apps/api
COPY --from=web-build /build/apps/web/dist /app/web
COPY deploy/supervisord.conf /etc/supervisor/conf.d/clip-farm.conf

ENV PYTHONPATH=/app/apps/api \
    DATA_DIR=/data \
    WEB_DIST_DIR=/app/web \
    PORT=8000 \
    PYTHONUNBUFFERED=1

WORKDIR /app/apps/api
EXPOSE 8000

CMD ["supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
