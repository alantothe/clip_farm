# Shared Google Cloud project. Application Default Credentials are used.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Optional: enables one batch job for long videos. Without it, long audio is
# transcribed in local 55-second chunks through the synchronous API.
GCS_BUCKET=
SPEECH_MODEL=long
SPEECH_LANGUAGE=en-US

# Optional browser and downloader configuration.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
YTDLP_COOKIES_FILE=
MAX_SOURCE_DURATION_SECONDS=3600
MAX_SOURCE_BYTES=2000000000
