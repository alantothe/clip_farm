# Shared Google Cloud project. Application Default Credentials are used.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Production alternative when an ADC file cannot be mounted. Store the entire
# service account key JSON as a secret variable; never commit its value.
GOOGLE_SERVICE_ACCOUNT_JSON=
GEMINI_MODEL=gemini-2.5-flash

# Optional: enables one batch job for long videos. Without it, long audio is
# transcribed in local 55-second chunks through the synchronous API.
GCS_BUCKET=
SPEECH_MODEL=long
SPEECH_LANGUAGE=en-US

# Optional browser and downloader configuration.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
YTDLP_COOKIES_FILE=
MAX_SOURCE_DURATION_SECONDS=3600
MAX_SOURCE_BYTES=2000000000

# Instagram API with Instagram Login. Create a Meta Business app, add the
# Instagram product, and register this exact callback URL in Business Login.
FRONTEND_URL=http://localhost:5173
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/platforms/instagram/callback
INSTAGRAM_API_VERSION=v23.0
# Required for publishing outside local development. Instagram fetches the
# rendered MP4 from a short-lived signed URL on this public HTTPS origin.
PUBLIC_BASE_URL=
INSTAGRAM_MEDIA_URL_TTL_SECONDS=3600
INSTAGRAM_PROCESSING_TIMEOUT_SECONDS=600
INSTAGRAM_POLL_INTERVAL_SECONDS=5

# Generate once with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
